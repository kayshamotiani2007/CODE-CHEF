#include <bits/stdc++.h>
using namespace std;

void solve() {
    int X , Y;
    cin >> X >> Y ;
    int a = 5*X;
    int b = 2*Y + X ;
    int c = Y + 3*X ;
    
    if(a<=b && a<=c) {
        cout << a << "\n" ;
    }
    else if(b<=c && b<=a) {
        cout << b << "\n" ;
        
    }
    else if(c<=a && c<=b) {
        cout << c << "\n" ;
    }
    
    
    
}
int main() {
    int T;
    cin >> T;
    while(T--) {
        solve() ;
    }
    return 0;
}