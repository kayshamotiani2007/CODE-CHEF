#include <bits/stdc++.h>
using namespace std;

void solve() {
    int X , Y;
    cin >> X >> Y ;
    int a = 5*X;
    int b = 2*Y + X ;
    int c = Y + 3*X ;
    
    int x = min({a,b,c}) ;
    cout << x << "\n" ;
    
    
    
}
int main() {
    int T;
    cin >> T;
    while(T--) {
        solve();
    }
    return 0;
}