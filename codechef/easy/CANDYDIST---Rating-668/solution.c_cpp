#include <bits/stdc++.h>
using namespace std;

void solve() {
    int N;
    int M;
    cin >> N;
    cin >> M;
    
    int x = N / M;
    
    if(N%M==0) {
        if(x%2==0) {
            cout << "YES\n" ;
            return;
            }
        else {
            cout << "NO\n" ;
            return;
        }
    }
    else {
        cout << "NO\n" ;
        return;
        
    }
}
int main() {
    int T;
    cin >> T;
    while(T--) {
        solve() ;
    }
    return 0;
}